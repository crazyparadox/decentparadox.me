---
// Pocket things, sketched by a shaky hand and shaded with pen hatching, for the empty areas of a page:
// pebbles, clouds, a moon, wonky stars, a mushroom, a lightning bolt. Nothing here is geometric: every
// outline is a wobbly curve through jittered points, gone over twice like a real pen sketch, and every
// instance comes out different. They draw themselves in when they scroll into view. Decorative only.
interface Props {
  count?: number
  seed?: number
  class?: string
}
const { count = 3, seed = 1, class: className } = Astro.props

const rng = (s: number) => () => {
  s = (s + 0x6d2b79f5) | 0
  let t = Math.imul(s ^ (s >>> 15), 1 | s)
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296
}
const r = rng(seed * 7919 + 13)
const f = (n: number) => n.toFixed(1)
type P = number[]

// a closed, smooth curve through points (Catmull-Rom as cubic beziers)
const smooth = (p: P[], tension = 6) => {
  const n = p.length
  let d = `M${f(p[0][0])} ${f(p[0][1])}`
  for (let i = 0; i < n; i++) {
    const a = p[(i - 1 + n) % n], b = p[i], c = p[(i + 1) % n], e = p[(i + 2) % n]
    d += `C${f(b[0] + (c[0] - a[0]) / tension)} ${f(b[1] + (c[1] - a[1]) / tension)} ${f(c[0] - (e[0] - b[0]) / tension)} ${f(c[1] - (e[1] - b[1]) / tension)} ${f(c[0])} ${f(c[1])}`
  }
  return d + 'Z'
}
const shake = (p: P[], amt: number) => p.map(([x, y]) => [x + (r() - 0.5) * amt, y + (r() - 0.5) * amt])
// a lumpy round thing: radius wanders slowly as it goes round
const blob = (cx: number, cy: number, rx: number, ry: number, lump: number, n = 11) => {
  const a1 = r() * 6, a2 = r() * 6
  return Array.from({ length: n }, (_, i) => {
    const t = (i / n) * Math.PI * 2
    const k = 1 + lump * (Math.sin(t * 2 + a1) * 0.6 + Math.sin(t * 3 + a2) * 0.4)
    return [cx + Math.cos(t) * rx * k, cy + Math.sin(t) * ry * k]
  })
}

type Thing = { outline: P[]; tension?: number; marks?: P[][] }
const THINGS: (() => Thing)[] = [
  // pebble
  () => ({ outline: blob(50, 54, 40, 30, 0.14), marks: [blob(38, 46, 5, 3.5, 0.2, 7)] }),
  // cloud: a flat-ish belly and three humps
  () => ({
    outline: [[14, 66], [10, 54], [18, 44], [28, 43], [32, 30], [46, 24], [58, 30], [64, 38], [76, 36], [88, 46], [90, 58], [84, 66], [62, 69], [38, 68]],
  }),
  // crescent moon
  () => ({
    outline: [[58, 8], [42, 14], [28, 30], [24, 50], [30, 70], [46, 86], [66, 90], [52, 78], [44, 62], [42, 46], [46, 28]],
    marks: [blob(34, 40, 3.5, 3.5, 0.2, 7), blob(40, 66, 2.5, 2.5, 0.2, 7)],
  }),
  // star, the kind drawn in a margin
  () => ({
    outline: Array.from({ length: 10 }, (_, i) => {
      const t = -Math.PI / 2 + (i / 10) * Math.PI * 2, rad = i % 2 ? 19 + r() * 5 : 42 + r() * 6
      return [50 + Math.cos(t) * rad, 52 + Math.sin(t) * rad]
    }),
    tension: 14,
  }),
  // mushroom
  () => ({
    outline: [[12, 52], [16, 34], [30, 18], [50, 12], [70, 18], [84, 34], [88, 52], [70, 56], [60, 57], [62, 76], [60, 90], [50, 93], [40, 90], [38, 76], [40, 57], [30, 56]],
    marks: [blob(36, 34, 5, 4, 0.2, 7), blob(58, 28, 6, 5, 0.2, 7), blob(70, 42, 3.5, 3, 0.2, 7)],
  }),
  // lightning bolt
  () => ({ outline: [[56, 6], [24, 54], [44, 54], [34, 94], [76, 40], [54, 42], [68, 8]], tension: 30 }),
  // a bigger, flatter stone
  () => ({ outline: blob(50, 56, 44, 24, 0.12, 12) }),
]

// pen hatching: bowed strokes with uneven gaps, some of them skipped
const hatch = (dir: 1 | -1, step: number, skip: number) => {
  const out: string[] = []
  for (let t = -105; t < 210; t += step * (0.6 + r() * 0.9)) {
    if (r() < skip) continue
    const x0 = t + (r() - 0.5) * 4, x1 = t + dir * (100 + r() * 20) + (r() - 0.5) * 4
    out.push(`M${f(x0)} -5Q${f((x0 + x1) / 2 + (r() - 0.5) * 7)} ${f(50 + (r() - 0.5) * 8)} ${f(x1)} 105`)
  }
  return out
}

const cols = Math.min(count, 3), rows = Math.ceil(count / cols)
const start = Math.floor(r() * THINGS.length)
const items = Array.from({ length: count }, (_, i) => {
  const thing = THINGS[(start + i * 3) % THINGS.length]()
  const base = shake(thing.outline, 3)
  const col = i % cols, row = Math.floor(i / cols)
  return {
    id: `pt${seed}-${i}`,
    size: Math.round(100 + r() * 90),
    left: ((col + 0.14 + r() * 0.4) / cols) * 100,
    top: ((row + 0.08 + r() * 0.35) / rows) * 100,
    tilt: Math.round((r() - 0.5) * 36),
    shape: smooth(base, thing.tension),
    // the pen went round twice and did not land in the same place
    again: smooth(shake(base, 2.6), thing.tension),
    marks: (thing.marks ?? []).map((m) => smooth(shake(m, 1))),
    shade: smooth(shake([[104, -4], [104, 104], [-4, 104], [30 + r() * 20, 60 + r() * 14], [62 + r() * 14, 30 + r() * 16]], 6), 5),
    light: hatch(-1, 9, 0.25),
    dark: hatch(-1, 4.6, 0.08),
    cross: hatch(1, 7, 0.3),
  }
})
---

<div class:list={['dp-parts', className]} aria-hidden="true" style={`--rows:${rows}`}>
  {
    items.map((it) => (
      <svg class="dp-part" viewBox="-6 -6 112 112" width={it.size} height={it.size} style={`left:${it.left.toFixed(1)}%; top:${it.top.toFixed(1)}%; --tilt:${it.tilt}deg`}>
        <defs>
          <clipPath id={it.id}><path d={it.shape} /></clipPath>
          <clipPath id={`${it.id}s`}><path d={it.shade} /></clipPath>
        </defs>
        <g clip-path={`url(#${it.id})`} class="dp-part__hatch">
          {it.light.map((d) => <path d={d} />)}
          <g clip-path={`url(#${it.id}s)`}>
            {it.dark.map((d) => <path d={d} />)}
            {it.cross.map((d) => <path d={d} />)}
          </g>
        </g>
        <path class="dp-part__line" d={it.shape} />
        <path class="dp-part__line dp-part__line--again" d={it.again} />
        {it.marks.map((d) => <path class="dp-part__line dp-part__line--thin" d={d} />)}
      </svg>
    ))
  }
</div>

<script>
  const init = () => {
    const parts = [...document.querySelectorAll<SVGSVGElement>('svg.dp-part')]
    if (!parts.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return
    // draw each one in, hatching first then the outline, the first time it is seen
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          io.unobserve(e.target)
          e.target.querySelectorAll<SVGPathElement>('path:not(defs path)').forEach((p, i) => {
            p.style.transition = `stroke-dashoffset 520ms cubic-bezier(0.3, 0.6, 0.2, 1) ${i * 14}ms`
            p.style.strokeDashoffset = '0'
          })
        })
      },
      { threshold: 0.3 },
    )
    parts.forEach((svg) => {
      svg.querySelectorAll<SVGPathElement>('path:not(defs path)').forEach((p) => {
        const len = Math.ceil(p.getTotalLength()) + 2
        p.style.strokeDasharray = `${len}`
        p.style.strokeDashoffset = `${len}`
      })
      io.observe(svg)
    })
  }
  document.addEventListener('astro:page-load', init)
</script>
