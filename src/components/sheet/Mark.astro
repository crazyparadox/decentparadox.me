---
// The logomark: "give or take", the plus-minus sign in Sasank's own handwriting (traced from his sheet).
// Takes currentColor. `size` is its height. The plus and the bar are separate so they can move:
// see .dp-mark in sheet.css.
interface Props {
  size?: number
  plain?: boolean // the pen line as written; without it the strokes are thickened to hold at small sizes
}
const { size = 24, plain = false } = Astro.props
const weight = plain ? 0 : 46
const width = Math.round(((size * 1073) / 835) * 100) / 100
---

