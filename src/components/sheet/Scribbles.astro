---
// Hand-drawn marks over text. Put data-scribble="circle | underline | strike" on an inline element
// and this draws a wobbly stroke around or under it. It also draws in every .dp-doodle.
// Decorative only: without script, or with reduced motion, doodles show still and text is untouched.
---

<script>
  const NS = 'http://www.w3.org/2000/svg'

  // small seeded generator, so a mark keeps its shape between redraws
  const rng = (seed: number) => () => {
    seed = (seed + 0x6d2b79f5) | 0
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }

  // a smooth curve through points (Catmull-Rom as cubic beziers)
  const through = (p: number[][]) => {
    let d = `M${p[0][0].toFixed(1)} ${p[0][1].toFixed(1)}`
    for (let i = 0; i < p.length - 1; i++) {
      const a = p[Math.max(0, i - 1)], b = p[i], c = p[i + 1], e = p[Math.min(p.length - 1, i + 2)]
      d += ` C${(b[0] + (c[0] - a[0]) / 6).toFixed(1)} ${(b[1] + (c[1] - a[1]) / 6).toFixed(1)}, ${(c[0] - (e[0] - b[0]) / 6).toFixed(1)} ${(c[1] - (e[1] - b[1]) / 6).toFixed(1)}, ${c[0].toFixed(1)} ${c[1].toFixed(1)}`
    }
    return d
  }

  const shapes: Record<string, (w: number, h: number, pad: number, r: () => number) => string> = {
    // a loop and a bit, like circling a word twice without lifting the pen
    circle(w, h, pad, r) {
      const cx = pad + w / 2, cy = pad + h / 2 + h * 0.04
      const pts: number[][] = []
      const n = 30, start = Math.PI * (0.95 + r() * 0.2)
      for (let i = 0; i <= n; i++) {
        const t = i / n
        const a = start + t * Math.PI * 2 * 1.42
        const grow = 1 + t * 0.07
        const rx = (w / 2 + pad * 0.72) * grow * (1 + (r() - 0.5) * 0.05)
        const ry = (h / 2 + pad * 0.1) * grow * (1 + (r() - 0.5) * 0.1)
        pts.push([cx + Math.cos(a) * rx, cy + Math.sin(a) * ry])
      }
      return through(pts)
    },
    // there and back under the word
    underline(w, h, pad, r) {
      const y = pad + h * 0.98, pts: number[][] = []
      for (let i = 0; i <= 5; i++) pts.push([pad - 4 + ((w + 8) * i) / 5, y + (r() - 0.5) * 4])
      for (let i = 5; i >= 1; i--) pts.push([pad - 4 + ((w + 8) * (i - 0.4)) / 5, y + 5 + (r() - 0.5) * 4])
      return through(pts)
    },
    strike(w, h, pad, r) {
      const y = pad + h * 0.56, pts: number[][] = []
      for (let i = 0; i <= 4; i++) pts.push([pad - 5 + ((w + 10) * i) / 4, y + (r() - 0.5) * 5])
      return through(pts)
    },
  }

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches

  const drawIn = (paths: SVGPathElement[], host: Element) => {
    if (still) return
    // doodles keep their stroke width when scaled, so their dashes are measured in screen pixels
    const svg = paths[0]?.ownerSVGElement
    const box = svg?.viewBox.baseVal
    const k = svg && box && box.width ? Math.max(svg.clientWidth / box.width, svg.clientHeight / box.height) : 1
    paths.forEach((p) => {
      const len = Math.ceil(p.getTotalLength() * k) + 2
      p.style.strokeDasharray = `${len}`
      p.style.strokeDashoffset = `${len}`
    })
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        io.disconnect()
        paths.forEach((p, i) => {
          const ms = Math.min(900, 260 + p.getTotalLength() * 1.1)
          p.style.transition = `stroke-dashoffset ${ms}ms cubic-bezier(0.3, 0.6, 0.2, 1) ${200 + i * 260}ms`
          p.style.strokeDashoffset = '0'
        })
      },
      { threshold: 0.6 },
    )
    io.observe(host)
  }

  const scribble = (el: HTMLElement, animate: boolean) => {
    const kind = el.dataset.scribble || 'underline'
    const make = shapes[kind]
    if (!make) return
    el.querySelector(':scope > svg.dp-scribble')?.remove()
    const w = el.offsetWidth, h = el.offsetHeight
    if (!w || !h) return
    const pad = Math.max(8, Math.round(h * 0.22))
    const seed = [...(el.textContent || kind)].reduce((a, c) => a + c.charCodeAt(0), kind.length * 97)
    const svg = document.createElementNS(NS, 'svg')
    svg.setAttribute('class', 'dp-scribble')
    svg.setAttribute('aria-hidden', 'true')
    svg.setAttribute('width', `${w + pad * 2}`)
    svg.setAttribute('height', `${h + pad * 2}`)
    svg.style.left = `${-pad}px`
    svg.style.top = `${-pad}px`
    const path = document.createElementNS(NS, 'path')
    path.setAttribute('d', make(w, h, pad, rng(seed)))
    svg.append(path)
    el.append(svg)
    if (animate) drawIn([path], el)
  }

  let t = 0
  let redraw = () => {}

  const init = () => {
    const marked = [...document.querySelectorAll<HTMLElement>('[data-scribble]')]
    // wait for the webfonts, or the marks are sized to fallback text
    const go = (animate: boolean) => marked.forEach((el) => scribble(el, animate))
    ;(document.fonts?.ready ?? Promise.resolve()).then(() => go(true))
    document.querySelectorAll<SVGSVGElement>('svg.dp-doodle').forEach((svg) => drawIn([...svg.querySelectorAll('path')], svg))
    // one resize listener, however many times the router re-runs init
    window.removeEventListener('resize', redraw)
    redraw = () => {
      clearTimeout(t)
      t = window.setTimeout(() => go(false), 160)
    }
    window.addEventListener('resize', redraw)
  }

  document.addEventListener('astro:page-load', init)
</script>
