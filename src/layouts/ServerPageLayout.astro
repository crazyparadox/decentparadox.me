---
import Head from '@/components/Head.astro'
import PageHead from '@/components/PageHead.astro'
import Scribbles from '@/components/sheet/Scribbles.astro'
import SheetFooter from '@/components/sheet/SheetFooter.astro'
import SheetNav from '@/components/sheet/SheetNav.astro'
import { SITE } from '@/consts'
import '@/styles/global.css'
import '@/styles/sheet.css'
type Props = {
  title: string
  description: string
  image?: string
  plain?: boolean
}

const { title, description, image, plain = false } = Astro.props
---

<!doctype html>
<html lang="en" class="dp-root bg-background text-foreground" data-theme="light" data-palette="cream-blue">
  <Head>
      <PageHead title={title} description={description} />
  </Head>
  <body>
    <div class="dp-home" id="top">
      <div class="dp-topblur" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="dp-sheet">
        <SheetNav />
        {
          plain ? (
            <main>
              <slot />
            </main>
          ) : (
            <main class="dp-page">
              <div class="mx-auto flex grow flex-col gap-y-6">
                <slot />
              </div>
            </main>
          )
        }
      </div>
      <SheetFooter />
    </div>
    <Scribbles />
  </body>
</html>
