---
import PageHead from '@/components/PageHead.astro'
import Doodle from '@/components/sheet/Doodle.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout plain>
  <PageHead slot="head" title="404" noindex />
  <section class="dp-lost">
    <img class="dp-scene" src="/static/images/character/scene-404-cut.webp" alt="The mascot shrugging beside an empty cardboard box" width="864" height="992" />
    <div class="dp-lost__text">
      <p class="dp-micro dp-eyebrow dp-eyebrow--doodle"><Doodle name="star" /><b>404</b></p>
      <h1 class="dp-hand dp-lost__line">no idea where that went.</h1>
      <p class="dp-body">The page you asked for isn't here. It may have moved, or it never existed.</p>
      <a class="dp-link" href="/">back to the index <Doodle name="arrow-r" size={24} /></a>
    </div>
  </section>
</Layout>
