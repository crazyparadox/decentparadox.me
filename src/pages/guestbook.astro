---
export const prerender = false
import PageIntro from '@/components/sheet/PageIntro.astro'
import { stamp } from '@/lib/ago'
import Layout from '@/layouts/ServerPageLayout.astro'
import { neon } from '@neondatabase/serverless'
import { SITE } from '@/consts'

const sql = neon(import.meta.env.NEON_DATABASE_URL)
const req = Astro.request

function sanitize(input: string) {
  return input.replace(/</g, '&lt;').replace(/>/g, '&gt;')
}

if (
  req.method === 'POST' &&
  req.headers.get('Content-Type')?.includes('application/x-www-form-urlencoded')
) {
  const data = new URLSearchParams(await req.text())
  console.log('Searching for: ' + data)
  const name = sanitize(data.get('name')?.trim() ?? '')
  const url = sanitize(data.get('link')?.trim() ?? '')
  const message = sanitize(data.get('message')?.trim() ?? '')
  const anon = data.get('anonymous') === 'on'
  if (
    name &&
    name?.length <= 64 &&
    (!url || url.includes('://')) &&
    url.length <= 128 &&
    message.length <= 320
  ) {
    const timestamp = Date.now()
    // CREATE TABLE entries (name TEXT, timestamp INTEGER, url TEXT, message TEXT)
    const result = await sql`
    INSERT INTO "Guestbook" ("name", "socialLink", "message", "isAnonymous", "createdAt")
    VALUES (${name}, ${url || null}, ${message}, ${anon}, ${timestamp});
  `
  }
}

const result =
  await sql`SELECT * FROM "Guestbook" ORDER BY "Guestbook"."createdAt" DESC`

---

<Layout title="Guestbook" description={SITE.DESCRIPTION} plain>
  <PageIntro label="guestbook" count={result?.length}>
    say something. it stays <em data-scribble="underline">here</em>.
  </PageIntro>

  <div class="dp-grid gb">
    <div class="gb__side">
    <img class="dp-scene gb__art" src="/static/images/character/scene-guestbook-cut.webp" alt="The mascot sitting on an open guestbook, signing it with a fountain pen as tall as he is" width="851" height="730" />
    <form id="guestbookForm" class="gb__form" method="post" enctype="application/x-www-form-urlencoded">
      <label class="dp-field">
        <span class="dp-micro">name</span>
        <input id="name" name="name" type="text" required maxlength="64" autocomplete="name" />
      </label>
      <label class="dp-field">
        <span class="dp-micro">link <i>optional</i></span>
        <input id="link" name="link" type="url" maxlength="128" placeholder="https://" />
      </label>
      <label class="dp-field">
        <span class="dp-micro">message</span>
        <textarea name="message" rows="4" maxlength="320"></textarea>
      </label>
      <label class="dp-check">
        <input type="checkbox" id="formAnonymous" name="anonymous" />
        <span class="dp-micro">sign as anonymous</span>
      </label>
      <button class="dp-btn dp-btn--ink" id="submitButton" type="submit">sign the guestbook</button>
    </form>
    </div>

    <ul class="gb__list">
      {
        result?.map((e) => (
          <li class="gb__entry">
            <div class="gb__who">
              {e.socialLink && !e.isAnonymous ? (
                <a rel="ugc" href={e.socialLink} target="_blank">
                  <h2>{e.name}</h2>
                </a>
              ) : (
                <h2>{e.isAnonymous ? 'anonymous' : e.name}</h2>
              )}
              <span class="dp-micro dp-micro--faint">{stamp(new Date(Number(e.createdAt)))}</span>
            </div>
            {e.message && <p class="dp-body" set:html={e.message} />}
          </li>
        ))
      }
    </ul>
  </div>
    <script is:inline>
      const submitButton = document.querySelector('#submitButton')
      document.forms[0].addEventListener('submit', () => {
        submitButton.disabled = true
      })
    </script>
</Layout>
